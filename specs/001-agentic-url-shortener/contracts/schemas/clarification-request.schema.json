{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc:schema:clarification-request:1.0.0",
  "title": "ClarificationRequest",
  "description": "Questions a human must answer before the affected path may continue (FR-GOV-08, FR-RPL-06).",
  "type": "object",
  "required": ["round", "raisedBy", "reason", "questions"],
  "additionalProperties": false,
  "properties": {
    "round": { "type": "integer", "minimum": 1 },
    "raisedBy": { "type": "string" },
    "reason": { "type": "string" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["questionId", "ambiguityId", "question", "severity", "affects", "options", "allowFreeText"],
        "additionalProperties": false,
        "properties": {
          "questionId": { "type": "string" },
          "ambiguityId": { "type": "string" },
          "question": { "type": "string" },
          "severity": { "enum": ["HIGH", "MEDIUM", "LOW"] },
          "affects": { "type": "array", "items": { "type": "string" } },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["optionId", "label", "impact"],
              "additionalProperties": false,
              "properties": {
                "optionId": { "type": "string" },
                "label": { "type": "string" },
                "impact": { "type": "string" }
              }
            }
          },
          "allowFreeText": { "type": "boolean" }
        }
      }
    }
  }
}
